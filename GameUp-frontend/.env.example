# ============================================================
# GameUP frontend — variables de entorno
# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
#
# IMPORTANTE: toda variable que empiece por EXPO_PUBLIC_ queda DENTRO de la app
# y cualquiera podría leerla. Aquí NUNCA van claves secretas (ni DATABASE_URL,
# ni SUPABASE_SECRET_KEY, ni service_role). Esas viven solo en el backend.
# ============================================================

# URL base de la API NestJS.
# En el celular NO sirve "localhost": usa la IP local del PC (ipconfig → IPv4)
# y conecta el celular y el PC a la misma red Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1
