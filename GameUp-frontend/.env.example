# ============================================================
# GameUP frontend — variables de entorno
# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
#
# IMPORTANTE: toda variable que empiece por EXPO_PUBLIC_ queda DENTRO de la app
# y cualquiera podría leerla. Aquí NUNCA van claves secretas (ni DATABASE_URL,
# ni SUPABASE_SECRET_KEY, ni service_role). Esas viven solo en el backend.
# ============================================================

# URL base de la API NestJS (backend desplegado).
# Una versión publicada exige https://; si falta o es http://, la app muestra
# «GameUP no está bien configurado» y no deja iniciar sesión.
EXPO_PUBLIC_API_URL=https://gameup-backend.onrender.com/api/v1
#
# Solo en desarrollo (Expo Go con `npx expo start`), para usar el backend de tu
# PC: pon la IP local del PC (ipconfig → IPv4). "localhost" NO sirve en el
# celular, y el celular y el PC deben estar en la misma red Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1

# De dónde salen los datos de la app (solo se respeta en desarrollo):
#   mock → datos ficticios en memoria, sin backend (por defecto en desarrollo)
#   api  → la API NestJS de EXPO_PUBLIC_API_URL
# Fuera de desarrollo la app usa SIEMPRE la API, diga lo que diga esta variable.
EXPO_PUBLIC_DATA_SOURCE=mock
