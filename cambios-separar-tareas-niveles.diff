+      .spyOn(repos.assignments, 'listPendingForStudent')
+      .mockResolvedValue([]);
+    await renderModule(repos);
+
+    expect(screen.getByText('¡Terminaste este tema!')).toBeOnTheScreen();
+  });
+});
