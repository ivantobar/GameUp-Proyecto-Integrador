@@ -0,0 +1,133 @@
+import { router } from 'expo-router';
+import { StyleSheet, View } from 'react-native';
+import {
+  AppText,
+  HeaderBackButton,
+  Screen,
+  ScreenHeader,
+  StateView,
+} from '@/components/ui';
+import { GameCard, NarrationButton } from '@/components/gameup';
+import { isLadderGame } from '@/data/types';
+import { LevelUpCelebration } from '@/features/games/components/LevelUpCelebration';
+import { gameHref, ladderHref } from '@/features/games/catalog';
+import { useGameList, type GameListItem } from '@/features/games/useGameList';
+import { useLevelCelebration } from '@/features/games/useLevelCelebration';
+import { useRefreshOnFocus } from '@/data/useRefreshOnFocus';
+import { spacing } from '@/theme';
+
+const TITLE = 'Jugar por niveles';
+const QUESTION = '¿A qué quieres jugar?';
+
+/** Agrupa las tarjetas de dos en dos (cuadrícula del mockup). */
+function pairs(items: GameListItem[]): GameListItem[][] {
+  const rows: GameListItem[][] = [];
+  for (let i = 0; i < items.length; i += 2) rows.push(items.slice(i, i + 2));
+  return rows;
+}
+
+/**
+ * A dónde lleva la tarjeta de un juego: el nivel actual de su escalera (los
+ * de pensar) o el juego libre (los de sonidos, o si los niveles no cargan).
+ * Nunca abre una tarea: las tareas están en «Tareas de tu profe».
+ */
+function cardHref({ game, level }: GameListItem) {
+  if (level && isLadderGame(game.id)) return ladderHref(game.id);
+  return gameHref(game);
+}
+
+/**
+ * Jugar por niveles: los juegos de pensar abren su nivel de la escalera y
+ * los de sonidos, el juego libre. Las tareas de la profe no salen aquí.
+ */
+export default function LevelsScreen() {
+  const { resource, reload, refresh } = useGameList();
+  // Al volver de un juego, las estrellas se actualizan.
+  useRefreshOnFocus(refresh);
+  const list = resource.status === 'ready' ? resource.data : null;
+  const celebration = useLevelCelebration(
+    list?.studentId ?? null,
+    list?.levels ?? null,
+  );
+
+  return (
+    <Screen
+      header={
+        <ScreenHeader
+          left={<HeaderBackButton onPress={() => router.back()} />}
+          title={TITLE}
+          right={<NarrationButton text={`${QUESTION} Toca un juego.`} />}
+        />
+      }
+    >
+      <AppText variant="display" accessibilityRole="header">
+        {QUESTION}
+      </AppText>
+
+      {resource.status === 'loading' ? (
+        <StateView kind="loading" title="Buscando tus juegos…" />
+      ) : null}
+      {resource.status === 'error' ? (
+        <StateView
+          kind="error"
+          title="Vamos a intentarlo otra vez"
+          action={{ label: 'Intentar de nuevo', onPress: reload }}
+        />
+      ) : null}
+
+      <LevelUpCelebration
+        levelUp={celebration.levelUp}
+        onClose={celebration.close}
+      />
+
+      {resource.status === 'ready'
+        ? resource.data.sections.map((section) => (
+            <View key={section.id} style={styles.section}>
+              <AppText
+                variant="label"
+                tone="secundario"
+                accessibilityRole="header"
+              >
+                {section.title}
+              </AppText>
+              {pairs(section.items).map((row) => (
+                <View
+                  key={row.map((item) => item.game.id).join('-')}
+                  style={styles.row}
+                >
+                  {row.map((item) => (
+                    <GameCard
+                      key={item.game.id}
+                      title={item.game.title}
+                      subtitle={item.game.subtitle}
+                      icon={item.game.icon}
+                      tone={item.game.tone}
+                      badge={item.badge}
+                      level={item.level?.level}
+                      // Su nivel actual (llega a la profe) o el juego libre.
+                      onPress={() => router.push(cardHref(item))}
+                    />
+                  ))}
+                  {/* Si la fila queda impar, un hueco mantiene el ancho. */}
+                  {row.length === 1 ? <View style={styles.spacer} /> : null}
+                </View>
+              ))}
+            </View>
+          ))
+        : null}
+    </Screen>
+  );
+}
+
+const styles = StyleSheet.create({
+  section: {
+    gap: spacing.md,
+  },
+  row: {
+    flexDirection: 'row',
+    gap: spacing.md,
+  },
+  spacer: {
+    flex: 1,
+  },
+});
diff --git a/GameUp-frontend/src/app/student/module/[moduleId].tsx b/GameUp-frontend/src/app/student/module/[moduleId].tsx
new file mode 100644
index 0000000..e8a7a9c
--- /dev/null
+++ b/GameUp-frontend/src/app/student/module/[moduleId].tsx
@@ -0,0 +1,127 @@
+import { router, useLocalSearchParams } from 'expo-router';
+import { useCallback } from 'react';
+import { StyleSheet, View } from 'react-native';
+import {
+  AppText,
+  Button,
+  HeaderBackButton,
+  Screen,
+  ScreenHeader,
+  StateView,
+} from '@/components/ui';
+import { Character, NarrationButton } from '@/components/gameup';
+import { useRepositories } from '@/data/RepositoryProvider';
+import { useResource } from '@/data/useResource';
+import { useRefreshOnFocus } from '@/data/useRefreshOnFocus';
+import { assignmentHref, findGame } from '@/features/games/catalog';
+import { TaskCard } from '@/features/games/components/TaskCard';
+import {
+  groupByModule,
+  taskBadge,
+  taskTitle,
+  type ModuleTasks,
+} from '@/features/games/moduleTasks';
+import { spacing } from '@/theme';
+
+const DONE_TITLE = '¡Terminaste este tema!';
+
+/**
+ * Tareas de la profe de un módulo (tema). Cada tarjeta abre esa actividad;
+ * su resultado va a la profe y cuenta para el módulo, no para los niveles.
+ */
+export default function ModuleTasksScreen() {
+  const params = useLocalSearchParams<{ moduleId: string }>();
+  const moduleId = String(params.moduleId ?? '');
+  const { students, assignments } = useRepositories();
+
+  const load = useCallback(async (): Promise<ModuleTasks | null> => {
+    const student = await students.getCurrentStudent();
+    const pending = await assignments.listPendingForStudent(student.id);
+    return groupByModule(pending).find((g) => g.moduleId === moduleId) ?? null;
+  }, [students, assignments, moduleId]);
+
+  const { resource, reload, refresh } = useResource(load);
+  // Al volver de una actividad, la lista se actualiza.
+  useRefreshOnFocus(refresh);
+
+  const group = resource.status === 'ready' ? resource.data : null;
+  const title = group?.title ?? 'Tareas de tu profe';
+  const narration = group
+    ? `${group.title}. Toca una actividad para jugarla.`
+    : DONE_TITLE;
+
+  return (
+    <Screen
+      header={
+        <ScreenHeader
+          left={<HeaderBackButton onPress={() => router.back()} />}
+          title={title}
+          right={<NarrationButton text={narration} />}
+        />
+      }
+    >
+      {resource.status === 'loading' ? (
+        <StateView kind="loading" title="Buscando tus actividades…" />
+      ) : null}
+      {resource.status === 'error' ? (
+        <StateView
+          kind="error"
+          title="Vamos a intentarlo otra vez"
+          action={{ label: 'Intentar de nuevo', onPress: reload }}
+        />
+      ) : null}
+
+      {resource.status === 'ready' && !group ? (
+        <View style={styles.center}>
+          <Character mouth="smile" size="lg" />
+          <AppText variant="title" style={styles.text}>
+            {DONE_TITLE}
+          </AppText>
+          <AppText tone="secundario" style={styles.text}>
+            Tu profe va a revisar lo que hiciste.
+          </AppText>
+          <Button
+            label="Volver a los juegos"
+            size="large"
+            onPress={() => router.back()}
+          />
+        </View>
+      ) : null}
+
+      {group ? (
+        <View style={styles.list}>
+          <AppText variant="display" accessibilityRole="header">
+            {group.title}
+          </AppText>
+          {group.tasks.map((task) => {
+            const game = findGame(task.gameId);
+            return (
+              <TaskCard
+                key={task.id}
+                caption={game.title}
+                title={taskTitle(task)}
+                icon={game.icon}
+                badge={taskBadge(task)}
+                accessibilityHint="Abre esta actividad de tu profe."
+                onPress={() => router.push(assignmentHref(task))}
+              />
+            );
+          })}
+        </View>
+      ) : null}
+    </Screen>
+  );
+}
+
+const styles = StyleSheet.create({
+  list: {
+    gap: spacing.md,
+  },
+  center: {
+    alignItems: 'center',
+    gap: spacing.md,
+  },
+  text: {
+    textAlign: 'center',
+  },
+});
