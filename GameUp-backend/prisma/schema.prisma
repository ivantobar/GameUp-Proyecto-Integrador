/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model usuario {
  id                    BigInt                  @id @default(autoincrement())
  rol_id                BigInt
  nombres               String
  apellidos             String
  correo                String?
  activo                Boolean                 @default(true)
  creado_en             DateTime                @default(now()) @db.Timestamptz(6)
  ultimo_acceso         DateTime?               @db.Timestamptz(6)
  id_usuario_auth       BigInt                  @unique(map: "uq_usuario_id_usuario_auth")
  id_acudiente_externo  BigInt?                 @unique(map: "uq_usuario_id_acudiente_externo")
  sincronizado_en       DateTime?               @db.Timestamptz(6)
  acudiente_estudiante  acudiente_estudiante[]
  asignacion            asignacion[]
  estudiante            estudiante?
  historial_nivel       historial_nivel[]
  modulo                modulo[]
  notificacion          notificacion[]
  observacion           observacion[]
  psicologo_estudiante  psicologo_estudiante[]
  tallerista_estudiante tallerista_estudiante[]
  rol                   rol                     @relation(fields: [rol_id], references: [id])
  validacion            validacion[]

  @@index([rol_id], map: "ix_usuario_rol")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model validacion {
  id                BigInt   @id @default(autoincrement())
  intento_id        BigInt   @unique
  validador_id      BigInt
  resultado         String
  retroalimentacion String?
  fecha             DateTime @default(now()) @db.Timestamptz(6)
  intento           intento  @relation(fields: [intento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario           usuario  @relation(fields: [validador_id], references: [id], onUpdate: NoAction)

  @@index([validador_id], map: "ix_validacion_validador")
}
