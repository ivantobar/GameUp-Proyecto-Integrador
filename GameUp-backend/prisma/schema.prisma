// Esquema de la base de datos de GameUP (Supabase / PostgreSQL).
// Documentación: https://pris.ly/d/prisma-schema
//
// Los modelos se generaron con `npx prisma db pull` a partir de las migraciones
// de prisma/migrations. Los triggers, las restricciones CHECK, RLS y los
// buckets de Storage viven solo en esas migraciones (Prisma no los modela).
// Después de cada cambio:
//   npm run db:migrate -- --name descripcion_del_cambio

generator client {
  provider            = "prisma-client"
  // Dentro de src/ para que `nest build` lo compile junto con la app.
  output              = "../src/generated/prisma"
  // Los índices parciales (por ejemplo, uq_asignacion_activa) se modelan con esta opción.
  previewFeatures     = ["partialIndexes"]
  // El backend usa módulos ES con imports terminados en .js
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model actividad {
  id                  BigInt                @id @default(autoincrement())
  modulo_id           BigInt
  tipo_juego_id       BigInt
  titulo              String
  instruccion_texto   String?
  configuracion       Json                  @default("{}")
  orden               Int                   @default(0)
  activa              Boolean               @default(true)
  modulo              modulo                @relation(fields: [modulo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tipo_juego          tipo_juego            @relation(fields: [tipo_juego_id], references: [id], onUpdate: NoAction)
  actividad_contenido actividad_contenido[]
  intento             intento[]

  @@unique([id, modulo_id], map: "uq_actividad_id_modulo")
  @@index([modulo_id, orden], map: "ix_actividad_modulo")
  @@index([tipo_juego_id], map: "ix_actividad_tipo_juego")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model actividad_contenido {
  actividad_id BigInt
  contenido_id BigInt
  rol_en_juego String?
  orden        Int       @default(0)
  palabra      String?
  url_imagen   String
  url_kinema   String?
  url_audio    String?
  actividad    actividad @relation(fields: [actividad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contenido    contenido @relation(fields: [contenido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([actividad_id, contenido_id])
  @@index([contenido_id], map: "ix_act_cont_contenido")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model acudiente_estudiante {
  acudiente_id  BigInt
  estudiante_id BigInt     @unique(map: "uq_acudiente_principal", where: raw("es_principal"))
  parentesco    String
  es_principal  Boolean    @default(false)
  usuario       usuario    @relation(fields: [acudiente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  estudiante    estudiante @relation(fields: [estudiante_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([acudiente_id, estudiante_id])
  @@index([estudiante_id], map: "ix_acud_est_estudiante")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asignacion {
  id               BigInt     @id @default(autoincrement())
  modulo_id        BigInt
  estudiante_id    BigInt
  asignado_por     BigInt
  fecha_asignacion DateTime   @default(now()) @db.Timestamptz(6)
  fecha_sugerida   DateTime?  @db.Date
  estado           String     @default("ASIGNADO")
  progreso         Int        @default(0)
  usuario          usuario    @relation(fields: [asignado_por], references: [id], onUpdate: NoAction)
  estudiante       estudiante @relation(fields: [estudiante_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)
  modulo           modulo     @relation(fields: [modulo_id], references: [id], onUpdate: NoAction)
  intento          intento[]

  @@unique([modulo_id, estudiante_id], map: "uq_asignacion_activa", where: raw("(estado <> 'COMPLETADO'::text)"))
  @@index([asignado_por], map: "ix_asignacion_asignado")
  @@index([estudiante_id, estado], map: "ix_asignacion_estudiante")
  @@index([modulo_id], map: "ix_asignacion_modulo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categoria {
  id          BigInt   @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  icono_url   String?
  modulo      modulo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contenido {
  id                  BigInt                @id @default(autoincrement())
  modulo_id           BigInt
  tipo                String
  titulo              String
  url_recurso         String
  orden               Int                   @default(0)
  actividad_contenido actividad_contenido[]
  modulo              modulo                @relation(fields: [modulo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, modulo_id], map: "uq_contenido_id_modulo")
  @@index([modulo_id, orden], map: "ix_contenido_modulo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model estudiante {
  usuario_id            BigInt                  @id
  nivel_id              BigInt
  personaje_avatar      String?
  fecha_ingreso         DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  estado                String                  @default("ACTIVO")
  id_estudiante_externo BigInt                  @unique(map: "uq_estudiante_id_estudiante_externo")
  acudiente_estudiante  acudiente_estudiante?
  asignacion            asignacion[]
  nivel                 nivel                   @relation(fields: [nivel_id], references: [id], onUpdate: NoAction)
  usuario               usuario                 @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  historial_nivel       historial_nivel[]
  observacion           observacion[]
  psicologo_estudiante  psicologo_estudiante[]
  tallerista_estudiante tallerista_estudiante[]

  @@index([nivel_id], map: "ix_estudiante_nivel")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grabacion_estudiante {
  id                           BigInt    @id @default(autoincrement())
  intento_id                   BigInt    @unique(map: "uq_grabacion_estudiante_intento")
  ruta_audio                   String
  duracion_seg                 Int?
  codigo_version_terminos      String
  consentimiento_verificado_en DateTime  @db.Timestamptz(6)
  creada_en                    DateTime  @default(now()) @db.Timestamptz(6)
  eliminada_en                 DateTime? @db.Timestamptz(6)
  intento                      intento   @relation(fields: [intento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model historial_nivel {
  id            BigInt     @id @default(autoincrement())
  estudiante_id BigInt
  nivel_id      BigInt
  asignado_por  BigInt
  motivo        String?
  fecha         DateTime   @default(now()) @db.Timestamptz(6)
  usuario       usuario    @relation(fields: [asignado_por], references: [id], onUpdate: NoAction)
  estudiante    estudiante @relation(fields: [estudiante_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)
  nivel         nivel      @relation(fields: [nivel_id], references: [id], onUpdate: NoAction)

  @@index([asignado_por], map: "ix_histnivel_asignado")
  @@index([estudiante_id, fecha(sort: Desc)], map: "ix_histnivel_estudiante")
  @@index([nivel_id], map: "ix_histnivel_nivel")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model intento {
  id                   BigInt                @id @default(autoincrement())
  asignacion_id        BigInt
  actividad_id         BigInt
  numero_intento       Int
  resultado            Json                  @default("{}")
  estrellas            Int                   @default(0)
  fecha                DateTime              @default(now()) @db.Timestamptz(6)
  grabacion_estudiante grabacion_estudiante?
  actividad            actividad             @relation(fields: [actividad_id], references: [id], onUpdate: NoAction)
  asignacion           asignacion            @relation(fields: [asignacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  validacion           validacion?

  @@unique([asignacion_id, actividad_id, numero_intento], map: "uq_intento")
  @@index([actividad_id], map: "ix_intento_actividad")
  @@index([asignacion_id], map: "ix_intento_asignacion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model modulo {
  id           BigInt       @id @default(autoincrement())
  categoria_id BigInt
  nivel_id     BigInt
  creado_por   BigInt
  musica_id    BigInt?
  nombre       String
  descripcion  String?
  portada_url  String?
  publicado    Boolean      @default(false)
  orden        Int          @default(0)
  creado_en    DateTime     @default(now()) @db.Timestamptz(6)
  actividad    actividad[]
  asignacion   asignacion[]
  contenido    contenido[]
  categoria    categoria    @relation(fields: [categoria_id], references: [id], onUpdate: NoAction)
  usuario      usuario      @relation(fields: [creado_por], references: [id], onUpdate: NoAction)
  musica       musica?      @relation(fields: [musica_id], references: [id], onUpdate: NoAction)
  nivel        nivel        @relation(fields: [nivel_id], references: [id], onUpdate: NoAction)

  @@index([categoria_id], map: "ix_modulo_categoria")
  @@index([creado_por], map: "ix_modulo_creado_por")
  @@index([musica_id], map: "ix_modulo_musica")
  @@index([nivel_id], map: "ix_modulo_nivel")
  @@index([publicado, orden], map: "ix_modulo_publicado")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
