  activo        Boolean    @default(true)
  estudiante    estudiante @relation(fields: [estudiante_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)
  usuario       usuario    @relation(fields: [psicologo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

