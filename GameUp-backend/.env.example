# ============================================================
# GameUP backend — variables de entorno
# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
# El archivo .env NUNCA se sube al repositorio.
# ============================================================

# development | production | test
NODE_ENV=development

# Puerto de la API (http://localhost:3000/api/v1)
PORT=3000

# ---------- Base de datos (Prisma) — OBLIGATORIA ----------
# Opción A, PostgreSQL local (como en clase):
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/gameup?schema=public"
# Opción B, Supabase: Project > Connect > "Session pooler" (puerto 5432):
# DATABASE_URL="postgresql://postgres.TU_REF:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- CORS ----------
# La app móvil (Expo Go) NO necesita CORS. Déjalo vacío salvo que pruebes
# la app en el navegador (Expo web), por ejemplo: http://localhost:8081
# CORS_ORIGINS=

# ---------- Despliegue (Render) ----------
# URL pública del backend; aparece como servidor "Producción" en Swagger.
# PUBLIC_URL=https://gameup-backend.onrender.com
# Proxies delante del backend: 0 en local, 1 en Render.
# TRUST_PROXY_HOPS=0

# ---------- API de seguridad (otro grupo): login y perfil ----------
# URL base, sin /api al final. El backend llama a <URL>/api/auth/login y
# <URL>/api/auth/perfil. Si falta, el login y las rutas protegidas responden 503.
# SEGURIDAD_API_URL=https://seguridad.ejemplo.com
# Milisegundos máximos por llamada (500 a 30000).
# SEGURIDAD_API_TIMEOUT_MS=5000
# Segundos que se recuerda un token ya verificado (0 a 300; nunca más que su exp).
# AUTH_CACHE_TTL_SEG=300

# ---------- Consentimiento de voz (API del núcleo familiar) ----------
# Aún no existe el endpoint para leer el consentimiento: sin él, GameUP
# responde "no concedido" y no guarda audio (falla cerrado).
# SOLO DESARROLLO: true hace que todos los estudiantes figuren con
# consentimiento, para probar Habla conmigo. Prohibido en producción
# (la app no arranca si NODE_ENV=production y esto es true).
# CONSENTIMIENTO_SIMULADO=false

# ---------- Supabase Auth / Storage (opcional por ahora) ----------
# Project Settings > API Keys
# SUPABASE_URL=https://TU_REF.supabase.co
# Clave SECRETA (sb_secret_... o la antigua "service_role").
# Solo va en el backend. NUNCA en la app móvil ni en el repositorio.
# SUPABASE_SECRET_KEY=
